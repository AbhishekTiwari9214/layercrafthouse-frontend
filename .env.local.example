# Local dev (direct to backend)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side proxy target (used by next.config rewrites + SSR)
API_PROXY_URL=http://localhost:8000

# Mobile via ngrok — comment out NEXT_PUBLIC_API_URL so the app uses same-origin /api proxy
# Then tunnel only the frontend: ngrok http 3000
